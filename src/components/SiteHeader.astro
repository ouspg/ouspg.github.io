---
import groupMark from '../assets/ouspg.svg?url';

const routes: Record<string, string> = { Home: '/', Studying: '/studying/', About: '/about/' };
const navigation = ['Home', 'Research', 'Studying', 'People', 'Join', 'Contact', 'About'].map(label => {
  const href = routes[label];
  const current = href && Astro.url.pathname.replace(/\/?$/, '/') === href;
  return { label, href, current };
});
---

<header class="site-header wrap">
  <div class="masthead">
    <a class="brand" href="/">
      <img src={groupMark} alt="" width="34" height="35" />
      <strong>OUSPG</strong>
      <span class="brand-name">Oulu University Secure Programming Group</span>
    </a>
    <details class="mobile-menu">
      <summary aria-label="Navigation menu">
        <span class="menu-icon" aria-hidden="true"></span>
      </summary>
      <nav aria-label="Primary navigation">
        <ul>
          {navigation.map(({ label, href, current }) => <li><a href={href} role={href ? undefined : 'link'} aria-disabled={href ? undefined : true} aria-current={current ? 'page' : undefined}>{label}</a></li>)}
        </ul>
      </nav>
    </details>
  </div>
  <nav class="desktop-menu" aria-label="Primary navigation">
    <ul>
      {navigation.map(({ label, href, current }) => <li><a href={href} role={href ? undefined : 'link'} aria-disabled={href ? undefined : true} aria-current={current ? 'page' : undefined}>{label}</a></li>)}
    </ul>
  </nav>
</header>
